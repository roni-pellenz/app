{
  "expo": {
    "name": "Finance",
    "slug": "finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "finance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
